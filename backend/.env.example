# Copia este archivo como .env (en esta misma carpeta backend/) y llena los valores.
# El .env NO se sube a GitHub: cada quien tiene el suyo.

# ---------- Servidor ----------
PORT=3000
# Dirección del frontend que puede llamar al backend
CORS_ORIGIN=http://localhost:5173
# Clave para firmar las sesiones. Genera una larga y aleatoria con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------- Base de datos ----------
# json  = base temporal en archivos (carpeta ./data), sin instalar MySQL. Solo desarrollo.
# mysql = base real (usa las variables DB_* de abajo)
DB_DRIVER=json
# Contraseña de los usuarios de prueba que crea la base JSON (admin y cajero1)
SEED_PASSWORD=Divix12345
# Operaciones ficticias de 2 años para la demo (solo si no hay operaciones). false = no generar
SEED_DEMO=true

#DB_HOST=localhost
#DB_PORT=3306
#DB_USER=root
#DB_PASSWORD=
#DB_NAME=divix

# ---------- Asistente de IA (Divix AI) ----------
# IA_PROVEEDOR=deepseek | anthropic. Si no se indica: DeepSeek si hay DEEPSEEK_API_KEY, si no Anthropic.
#IA_PROVEEDOR=
#DEEPSEEK_API_KEY=
#ANTHROPIC_API_KEY=
ASISTENTE_MAX_POR_MINUTO=5
ASISTENTE_MAX_POR_DIA=50

# ---------- Referencia del mercado (Tipos de cambio) ----------
# on/off. Sin token de Banxico se usa el Banco Central Europeo (Frankfurter).
REFERENCIA_MERCADO=on
# Token gratuito del SIE de Banxico para el dólar FIX (opcional)
#BANXICO_TOKEN=
# % de movimiento del mercado a partir del cual se avisa
#REFERENCIA_UMBRAL_PCT=1
